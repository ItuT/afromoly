{
  "name": "afromoly",
  "private": true,
  "version": "0.1.0",
  "description": "Afromoly: Johannesburg Edition — server-authoritative multiplayer board game",
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @afromoly/engine test",
    "test:watch": "pnpm --filter @afromoly/engine test:watch",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "hotseat": "pnpm --filter @afromoly/cli start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
